POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=doctordle

VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_BASE_URL=/api
VITE_CLERK_JWT_AUDIENCE=
VITE_SHARE_URL=
VITE_BACKEND_URL=http://backend:3000
VITE_API_URL=http://localhost:3000/api
VITE_LOCAL_QA_AUTH_ENABLED=false
VITE_LOCAL_QA_AUTH_TOKEN=

# Local editorial QA auth (development only; never commit a real token)
LOCAL_QA_AUTH_ENABLED=false
LOCAL_QA_AUTH_TOKEN=
LOCAL_QA_AUTH_USER_ID=local-qa-editor
LOCAL_QA_AUTH_EMAIL=local-qa-editor@example.test
LOCAL_QA_AUTH_ROLE=admin

# Backend runtime defaults now live in doctordle-backend/.env.
# Root .env is used for docker compose and frontend build-time VITE_* values.
