{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weos.local/schemas/governed-command-contract-registry.schema.json",
  "title": "WEOS Governed Command Contract Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "registryStatus",
    "commandContracts"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "registryStatus": { "type": "string", "minLength": 1 },
    "commandContracts": {
      "type": "array",
      "items": { "$ref": "governed-command-contract-definition.schema.json" }
    }
  }
}
