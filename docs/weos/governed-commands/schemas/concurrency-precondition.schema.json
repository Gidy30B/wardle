{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weos.local/schemas/concurrency-precondition.schema.json",
  "title": "WEOS Concurrency Precondition",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "preconditionMode", "dependencyRole"],
  "properties": {
    "target": {
      "$ref": "governed-command.schema.json#/$defs/GovernedCommandTargetReference"
    },
    "preconditionMode": {
      "enum": ["EXACT_REVISION", "EXPECTED_VERSION", "EXPECTED_TOKEN"]
    },
    "dependencyRole": { "type": "string", "minLength": 1 },
    "expectedRevisionId": { "type": "string", "minLength": 1 },
    "expectedVersion": { "type": "integer", "minimum": 0 },
    "expectedToken": { "type": "string", "minLength": 1 },
    "tokenPolicyType": { "type": "string", "minLength": 1 },
    "tokenPolicyVersion": { "type": "string", "minLength": 1 }
  }
}
