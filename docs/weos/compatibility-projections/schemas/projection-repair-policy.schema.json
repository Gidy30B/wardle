{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weos.local/schemas/projection-repair-policy.schema.json",
  "title": "WEOS Projection Repair Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["repairMode"],
  "properties": {
    "repairMode": {
      "enum": [
        "REBUILD_FROM_CANONICAL",
        "REPLAY_PROVEN_CANONICAL_EFFECT",
        "MARK_UNKNOWN",
        "MANUAL_GOVERNED_REVIEW_REQUIRED",
        "NO_AUTOMATIC_REPAIR"
      ]
    },
    "deterministicDerivationRequired": { "type": "boolean" },
    "provenCanonicalStateRequired": { "type": "boolean" },
    "provenCanonicalEffectRequired": { "type": "boolean" },
    "authorityEligibilityRequired": { "type": "boolean" },
    "expectedStateEligibilityRequired": { "type": "boolean" },
    "manualReviewRequired": { "type": "boolean" },
    "permittedDriftStatuses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "repairEvidenceRequirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conditions": { "type": "array", "items": { "type": "string" } }
  }
}
